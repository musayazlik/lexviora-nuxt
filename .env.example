# Database (PostgreSQL)
DATABASE_URL=postgresql://lexviora:lexviora@localhost:5432/lexviora

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Public site origin, including https:// (canonical, social cards, i18n, sitemap).
# Production: replace localhost with the public domain in Dokploy runtime env.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Docker Compose (used by db service)
POSTGRES_USER=lexviora
POSTGRES_PASSWORD=lexviora
POSTGRES_DB=lexviora

# Set to false to manage migrations manually instead of on server start
RUN_MIGRATIONS=true

# AI writing assistant (optional; server-side only)
# Choose a provider/model ID from https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_API_KEY=
AI_MODEL=

# Blog assistant, model catalog, research and generated images (OpenRouter)
OPENROUTER_API_KEY=

# UploadThing: new images/videos are stored remotely. Legacy files remain readable.
UPLOADTHING_TOKEN=

# Plunk: use a secret server key and a verified sender domain.
PLUNK_SECRET_KEY=
PLUNK_FROM_EMAIL=
PLUNK_CONTACT_TO_EMAIL=
PLUNK_WEBHOOK_SECRET=

# Existing local uploads (read-only compatibility)
MEDIA_DIR=.data/media
