# Database (PostgreSQL)
DATABASE_URL=postgresql://lexviora:lexviora@localhost:5432/lexviora

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Public site URL (SEO, i18n, sitemap)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Docker Compose (used by db service)
POSTGRES_USER=lexviora
POSTGRES_PASSWORD=lexviora
POSTGRES_DB=lexviora

# Set to false to manage migrations manually instead of on server start
RUN_MIGRATIONS=true
